<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.kamuinet.client.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.kamuinet.client.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/usageFragment"
        android:name="com.kamuinet.client.ui.UsageFragment"
        android:label="Usage"
        tools:layout="@layout/fragment_usage" />

    <fragment
        android:id="@+id/securityFragment"
        android:name="com.kamuinet.client.ui.SecurityFragment"
        android:label="Security"
        tools:layout="@layout/fragment_security" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.kamuinet.client.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_appSelectionFragment"
            app:destination="@id/appSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/appSelectionFragment"
        android:name="com.kamuinet.client.ui.AppSelectionFragment"
        android:label="App Split-Tunneling"
        tools:layout="@layout/fragment_app_selection" />

    <fragment
        android:id="@+id/helpFragment"
        android:name="com.kamuinet.client.ui.HelpFragment"
        android:label="Help"
        tools:layout="@layout/fragment_help" />

</navigation>
