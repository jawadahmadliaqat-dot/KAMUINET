<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kamui_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Settings"
            android:textColor="@color/kamui_fg"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/kamui_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/kamui_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Appearance"
                    android:textColor="@color/kamui_fg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/theme_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="4dp"
            android:text="Advanced (optional)"
            android:textColor="@color/kamui_fg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"
            android:text="Leave defaults unless you know your network."
            android:textColor="@color/kamui_muted"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/kamui_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/kamui_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kamui Gateway"
                    app:boxStrokeColor="@color/kamui_border"
                    app:hintTextColor="@color/kamui_muted">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/stun_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="stun.l.google.com:19302"
                        android:textColor="@color/kamui_fg" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tunnel ID"
                    app:boxStrokeColor="@color/kamui_border"
                    app:hintTextColor="@color/kamui_muted">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/port_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="54320"
                        android:textColor="@color/kamui_fg" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/upnp_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Auto port mapping"
                    android:textColor="@color/kamui_fg"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/direct_only_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Save Server Data (Direct Only)"
                    android:textColor="@color/kamui_fg"
                    android:checked="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="Disables Relay Server. Saves Oracle bandwidth but may fail on strict firewalls."
                    android:textColor="@color/kamui_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"
            android:text="Privacy &amp; Transparency"
            android:textColor="@color/kamui_fg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/kamui_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/kamui_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What we see"
                    android:textColor="@color/kamui_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Signaling Metadata (IP, Peer ID)\n• Total Bytes Shared\n• Connection Logs (Local Only)\n\nWe NEVER inspect the content of your traffic. All data is encrypted via Kamui Tunnel Protocol."
                    android:textColor="@color/kamui_muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"
            android:text="Account"
            android:textColor="@color/kamui_fg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/kamui_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/kamui_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/account_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="—"
                    android:textColor="@color/kamui_subtle"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sign_out"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Sign out"
                    android:textColor="@color/kamui_fg"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/kamui_border" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
